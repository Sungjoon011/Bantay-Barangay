# Copy this file to .env and fill in YOUR values. Never commit .env.
# The running API uses the limited role (app_user). Only the Prisma CLI uses the owner (DIRECT_URL).
DATABASE_URL="postgresql://app_user:YOUR_APP_USER_PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_OWNER_PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require"
JWT_SECRET="put-a-long-random-text-here"
PORT=3000
